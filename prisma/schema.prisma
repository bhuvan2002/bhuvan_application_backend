generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id         String   @id @default(uuid())
  date       DateTime
  symbol     String
  type       String
  strategy   String
  lotSize    Float
  entryPrice Float
  exitPrice  Float
  pnl        Float
  notes      String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Account {
  id            String    @id @default(uuid())
  name          String
  bankName      String
  accountNumber String
  ifsc          String?
  mobileAppKey  String?
  atmKey        String?
  balance       Float
  type          String    @default("BANK") // "BANK", "CREDIT_CARD", "LOAN"
  creditLimit   Float?
  dueDate       Int?
  loanEndDate   DateTime?
  emiAmount     Float?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  expenses      Expense[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime
  amount      Float
  category    String
  description String
  type        String   @default("DEBIT") // "DEBIT", "CREDIT", "TRANSFER"
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  toAccountId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Todo {
  id         String   @id @default(uuid())
  title      String
  isComplete Boolean  @default(false)
  priority   String
  dueDate    DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Plan {
  id        String   @id @default(uuid())
  title     String
  type      String
  startTime String 
  endTime   String 
  notes     String
  date      String   // Storing as YYYY-MM-DD string for simplicity as per FE logic
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  role      String    @default("TRADER") // 'TRADER' or 'PARENT'
  trades    Trade[]
  accounts  Account[]
  todos     Todo[]
  plans     Plan[]
  notes     Note[]
  bankAccounts BankAccount[]
  creditCards  CreditCard[]
  loans        Loan[]
}

model BankAccount {
  id            String    @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String?
  accountType   String    @default("SAVINGS")
  balance       Float
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  transactions  BankTransaction[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BankTransaction {
  id              String   @id @default(uuid())
  date            DateTime
  amount          Float
  type            String   // "CREDIT" | "DEBIT"
  category        String
  description     String
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  
  // Explicit relationships to prevent double counting
  creditCardPaymentId String? @unique
  loanEmiPaymentId    String? @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CreditCard {
  id             String    @id @default(uuid())
  cardName       String
  provider       String
  last4Digits    String?
  creditLimit    Float
  outstanding    Float     @default(0)
  billingCycle   Int?
  dueDate        Int?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  expenses       CreditCardExpense[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CreditCardExpense {
  id             String    @id @default(uuid())
  date           DateTime
  amount         Float
  category       String
  description    String
  creditCardId   String
  creditCard     CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Loan {
  id             String    @id @default(uuid())
  loanName       String
  provider       String
  totalAmount    Float
  emiAmount      Float
  startDate      DateTime
  tenureMonths   Int
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  emis           LoanEMI[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LoanEMI {
  id             String    @id @default(uuid())
  emiNumber      Int
  dueDate        DateTime
  amount         Float
  status         String    @default("UPCOMING") // UPCOMING, PAID
  paymentDate    DateTime?
  loanId         String
  loan           Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  bankAccountId  String?   
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
